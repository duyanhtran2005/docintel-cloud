# ==============================================================================
# DocIntel-Cloud: Mẫu cấu hình biến môi trường (Environment Variables Template)
# Hướng dẫn: Copy file này thành .env và điền các thông số tương ứng của bạn.
# Lệnh copy: cp .env.example .env (hoặc copy .env.example .env trên Windows)
# ==============================================================================

# 1. Cấu hình MinIO Object Storage (Giả lập AWS S3)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=documents

# 2. Cấu hình PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docintel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# 3. Cấu hình Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# 4. Cấu hình LLM APIs (Chọn Google Gemini hoặc Groq Cloud)
# Tùy chọn A: Google Gemini API (Lấy key miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Tùy chọn B: Groq Cloud API (Lấy key miễn phí tại: https://console.groq.com/keys)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant
